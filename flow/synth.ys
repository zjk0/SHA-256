# Path template: run with ./run_synth.sh (renders @...@ placeholders).
read_verilog -sv -I"@PROJECT_ROOT@/Verilog" "@PROJECT_ROOT@/Verilog/SHA256.v"
hierarchy -check -top SHA256
proc
flatten          # RESTORED: expansion protected by (* keep_hierarchy *)
opt
fsm
opt
memory
opt
techmap
opt
dfflibmap -liberty "@LIBERTY@"
opt
abc -liberty "@LIBERTY@" -script +strash;scorr;ifraig;retime,;map;print_stats
opt

# Insert tie cells (conb) for constants 1/0 to avoid OpenROAD DRT-0305
hilomap -hicell sky130_fd_sc_hd__conb_1 HI -locell sky130_fd_sc_hd__conb_1 LO

clean
stat
write_verilog -noattr "@FLOW_DIR@/SHA256_synth.v"
